<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Xio.Parallax.Client</RootNamespace>
    <AssemblyName>Xio.Parallax.Client</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>Xio.Parallax.Client</PackageId>
    <Version>0.4.0</Version>
    <Authors>XI Objects</Authors>
    <Company>XI Objects</Company>
    <Description>.NET client for the XI Parallax REST API: image registration, look-up, published records and attribution verification.</Description>
    <PackageTags>xio;parallax;attribution;c2pa</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xio.Parallax.Client.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blake3" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.Kiota.Bundle" />
    <PackageReference Include="Xio.Parallax.Common" />
  </ItemGroup>
</Project>
