# Inputs of the examples. Copy to .env (git-ignored) and fill in; then, in bash:
#   set -a; . ./.env; set +a
# or in PowerShell:
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#].*=' } | ForEach-Object { $n, $v = $_ -split '=', 2; Set-Item "env:$n" $v }

# The API's base URL
PARALLAX_BASE_URL=https://api.parallax.xiobjects.com
# The account token that registers
PARALLAX_TOKEN=
# A second account's token that looks an image up; defaults to PARALLAX_TOKEN
PARALLAX_LOOKUP_TOKEN=
# Orbital's base URL, whose anonymous /info serves the pinned trust roots
PARALLAX_ORBITAL_URL=
# A PEM file holding the pinned trust roots, as an alternative to PARALLAX_ORBITAL_URL
PARALLAX_ROOTS_PEM=
# Path of the image to register or look up
PARALLAX_IMAGE=
# The image's media type
PARALLAX_IMAGE_TYPE=image/png
# Path of a JSON manifest to attach under the kind xi-manifest
PARALLAX_MANIFEST=
# A folder or directory of images to register in one batch or sequence
PARALLAX_IMAGES=
# The operator's per-request byte cap
PARALLAX_MAX_REQUEST_BYTES=
# The operator's per-request image cap
PARALLAX_MAX_IMAGES=
# An open slot to resume into instead of opening a new one
PARALLAX_SLOT_ID=
# "yes" to include each image's embedded JUMBF manifest store(s); anything else omits them
PARALLAX_INCLUDE_EMBEDDED=no
# The constant interval, in milliseconds, between two sequence frames' source time offsets
PARALLAX_FRAME_INTERVAL_MS=
# The operator's per-request frame cap, for a sequence
PARALLAX_MAX_FRAMES_PER_REQUEST=
